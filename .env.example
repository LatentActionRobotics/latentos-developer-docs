# Copy this file to `.env` for local FTP deploy:
#   cp .env.example .env
#
# Never commit `.env`. For CI, add the same keys as GitHub Actions secrets
# (Settings → Secrets and variables → Actions).

FTP_SERVER=47.119.131.66
FTP_PORT=610
FTP_USERNAME=latent_docs
FTP_PASSWORD=
# Remote path relative to the FTP login home. Usually ./ when the account root maps to /docs.
FTP_SERVER_DIR=./
